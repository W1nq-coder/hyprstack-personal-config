[Unit]
Description=Hyprstack add-ons: offer an update when the repository has new commits
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE

[Service]
Type=oneshot
ExecStart=%h/.local/bin/hyprstack-personal-update

[Install]
# Запускается сразу при входе в графическую сессию, не дожидаясь таймера.
WantedBy=graphical-session.target
