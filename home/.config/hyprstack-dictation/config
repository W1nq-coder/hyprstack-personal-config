# Настройки голосового ввода (~/.local/bin/dictation).
# Меняются на странице «Настройки → Голосовой ввод» или здесь вручную.
# Файл читается при каждом нажатии, перезапуск не нужен. После смены
# MODEL/USE_GPU/THREADS модель перезагрузится сама при следующей записи.

# Режим: toggle — нажать для старта / нажать для остановки, hold — удерживать и говорить.
MODE="toggle"

# Микрофон: node.name источника; пусто — системный по умолчанию.
# Список микрофонов: dictation sources
SOURCE=""

# Модель whisper.cpp из ~/.local/share/whisper-models/.
MODEL="$HOME/.local/share/whisper-models/ggml-large-v3-turbo-q5_0.bin"

# Язык речи: ru, en или auto (определять автоматически).
LANGUAGE="ru"

# Звуковые сигналы при старте записи и после вставки текста: 1 — вкл, 0 — выкл.
SOUNDS="1"

# Громкость сигналов: от 0.1 (еле слышно) до 1.0.
SOUND_VOLUME=0.6

# Подсказка для модели: помогает правильно писать английские термины.
PROMPT="Диктовка команд в терминал Linux: git commit, git push, sudo pacman, paru, systemctl, docker, kitty, Hyprland, Python, JSON, API, SSH, cd, ls, grep."

# Ускорение: 1 — Vulkan на встроенной графике Intel, 0 — только процессор.
USE_GPU=1
THREADS=8

# Через сколько секунд простоя выгружать модель из памяти.
IDLE_TIMEOUT=180

# Максимальная длина записи в секундах (потом запись останавливается сама).
MAX_SECONDS=120

# Способ вставки: auto (kitty — через kitten @, остальные окна — wtype,
# при сбое — буфер обмена), wtype, clipboard.
INSERT_METHOD="auto"

# Локальный порт whisper-server (слушает только 127.0.0.1).
PORT=8178
