#!/usr/bin/env bash
# Проверяет, не появились ли в GitHub новые коммиты доработок HyperStack.
# Если появились — показывает уведомление с кнопками «Обновить» / «Отмена».
# Путь к репозиторию берётся из файла, который записывает install.sh, так что
# папка с клоном может быть где угодно.
set -uo pipefail

STATE=${XDG_STATE_HOME:-$HOME/.local/state}/hyprstack-personal
mkdir -p "$STATE"
REPO=$(cat "$STATE/repo" 2>/dev/null) || exit 0
[[ -d $REPO/.git ]] || exit 0

exec 9>"$STATE/lock"
flock -n 9 || exit 0

# При входе в систему оболочка (она же демон уведомлений) может ещё запускаться: ждём её до 30 с.
wait_for_notifier() {
    local i
    for i in $(seq 30); do
        busctl --user status org.freedesktop.Notifications >/dev/null 2>&1 && return 0
        sleep 1
    done
    return 1
}

note() { notify-send -a "HyperStack" -i software-update-available "$@"; }

export GIT_TERMINAL_PROMPT=0

# Быстрая проверка (запускается каждые пару минут): узнаём только номер последнего коммита
# в GitHub. Ничего не качаем, пока он не отличается от нашего или от того, от чего отказались.
upstream=$(git -C "$REPO" rev-parse --abbrev-ref '@{u}' 2>/dev/null) || exit 0
latest=$(timeout 20 git -C "$REPO" ls-remote "${upstream%%/*}" "refs/heads/${upstream#*/}" 2>/dev/null | cut -f1)
[[ -n $latest ]] || exit 0                              # нет сети — тихо выходим
local_=$(git -C "$REPO" rev-parse HEAD)
[[ $latest == "$local_" ]] && exit 0
[[ $(cat "$STATE/dismissed" 2>/dev/null) == "$latest" ]] && exit 0

timeout 120 git -C "$REPO" fetch --quiet 2>/dev/null || exit 0
remote=$(git -C "$REPO" rev-parse '@{u}' 2>/dev/null) || exit 0
[[ $local_ == "$remote" ]] && exit 0
# Только если у нас нет ничего лишнего: наш HEAD должен быть предком удалённого.
if ! git -C "$REPO" merge-base --is-ancestor "$local_" "$remote"; then
    # В копии есть коммиты, которых нет в GitHub: обновить «догоном» нельзя. Говорим один раз.
    if [[ $(cat "$STATE/diverged" 2>/dev/null) != "$remote" ]]; then
        echo "$remote" > "$STATE/diverged"
        wait_for_notifier && note "Автообновление HyperStack невозможно" "В $REPO есть коммиты, которых нет на GitHub. Выполните там: git pull --rebase && ./install.sh"
    fi
    exit 0
fi

# Уже отказались от именно этой версии — не напоминаем.
[[ $(cat "$STATE/dismissed" 2>/dev/null) == "$remote" ]] && exit 0
# Не отвечали — переспрашиваем не чаще раза в 3 часа.
if [[ $(cut -d' ' -f1 "$STATE/asked" 2>/dev/null) == "$remote" ]]; then
    last=$(cut -d' ' -f2 "$STATE/asked")
    (( $(date +%s) - last < 10800 )) && exit 0
fi

count=$(git -C "$REPO" rev-list --count "$local_..$remote")
subjects=$(git -C "$REPO" log --format='• %s' -n 5 "$local_..$remote" | tr -d '<>[]`*_#\\' | cut -c1-120)

# Метку «уже спрашивали» ставим только когда уведомление реально можно показать: иначе при медленной
# загрузке оболочки мы бы промолчали на ближайшие 3 часа.
wait_for_notifier || exit 0
echo "$remote $(date +%s)" > "$STATE/asked"
answer=$(timeout 900 notify-send -a "HyperStack" -i software-update-available -u normal -t 0 \
    -A update=Обновить -A cancel=Отмена \
    "Доработки HyperStack обновились" "Новых изменений: $count
$subjects")

case $answer in
    update)
        if [[ -n $(git -C "$REPO" status --porcelain --untracked-files=no) ]]; then
            note "Обновление не выполнено" "В $REPO есть ваши незакоммиченные правки. Сохраните их и обновите вручную: git pull && ./install.sh"
            exit 1
        fi
        if ! git -C "$REPO" pull --ff-only --quiet; then
            note -u critical "Обновление не выполнено" "git pull не удался."
            exit 1
        fi
        args=(--no-wallpapers)   # обои (~2 ГБ) при обновлении не качаем
        [[ -f $STATE/personal ]] && args+=(--personal)
        note "Применяю обновление" "Оболочка перезапустится на несколько секунд."
        if "$REPO/install.sh" "${args[@]}" </dev/null >"$STATE/last-install.log" 2>&1; then
            rm -f "$STATE/asked"
            note "Готово" "HyperStack обновлён до $(git -C "$REPO" rev-parse --short HEAD)."
        else
            note -u critical "Обновление применилось с ошибкой" "Подробности: $STATE/last-install.log"
        fi
        ;;
    cancel)
        echo "$remote" > "$STATE/dismissed"
        ;;
esac
exit 0
