[Desktop Entry]
Type=Application
Name=VPN
GenericName=VPN client
GenericName[ru]=VPN-клиент
Comment=Subscriptions and servers of the HyperStack VPN
Comment[ru]=Подписки и серверы VPN в HyperStack
Exec=sh -c 'exec qs --path "${XDG_DATA_HOME:-$HOME/.local/share}/hyprstack-personal/shell" ipc call vpn open'
Icon=network-vpn
Terminal=false
Categories=Network;
Keywords=vpn;vless;proxy;subscription;впн;прокси;подписка;
